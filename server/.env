# Copia este archivo a .env y rellénalo
PORT=3000

# Servidor de Minecraft para contar jugadores online
MC_HOST=akirapvp.lat
MC_PORT=25565

# Clave compartida con el plugin /web (pon una larga y aleatoria; la misma en plugin/config.yml)
PLUGIN_SECRET=cambia-esto-por-una-clave-larga
# Firma de sesiones (otra clave larga aleatoria)
SESSION_SECRET=cambia-esto-tambien

# MySQL (la misma base donde están tus stats y tu plugin de sanciones). Si lo dejas vacío usa modo demo/archivo.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Tienda del servidor (botón de la web)
STORE_URL=https://store.akirapvp.lat/
DISCORD_URL=https://discord.gg/tu-invite
SERVER_IP=akirapvp.lat

# 1 si estás detrás de un proxy (Nginx, Clever Cloud, Render...) para leer la IP real
TRUST_PROXY=0
